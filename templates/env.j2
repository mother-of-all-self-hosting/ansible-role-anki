TZ={{ anki_environment_variables_tz }}

{#
See: https://docs.ankiweb.net/sync-server.html

The server reads its whole configuration from `SYNC_*` environment variables.
#}

SYNC_USER1={{ anki_environment_variables_username }}:{{ anki_environment_variables_password }}

{#
Where the server keeps the collections it is entrusted with. The container
image happens to default to the same path, but stating it here means the
directory the role bind-mounts and the directory the server writes to cannot
drift apart silently.
#}
SYNC_BASE={{ anki_container_data_path }}

{% if anki_container_image_self_build %}
PUID={{ anki_uid }}
PGID={{ anki_gid }}
{% endif %}

{{ anki_environment_variables_additional_variables }}
